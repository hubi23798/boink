# ── Local dev with Supabase ──────────────────────────────────────────────────
# Run `supabase start` first. Values come from `supabase status`.
#
# pnpm dev (recommended):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<from supabase status>
SUPABASE_SERVICE_ROLE_KEY=<from supabase status>
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# docker compose up (macOS/Windows — uses host.docker.internal):
# These are set inside docker-compose.yml automatically. Just export
# SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY in your shell first:
#   export SUPABASE_ANON_KEY=$(supabase status --output json | jq -r .ANON_KEY)
#   export SUPABASE_SERVICE_ROLE_KEY=$(supabase status --output json | jq -r .SERVICE_ROLE_KEY)
#
# ── Production (Supabase cloud — EU Frankfurt primary) ───────────────────────
# Create project `truffe-eu` in eu-central-1. See docs/operations/supabase-eu-provisioning.md
# Project ref (truffe-eu): ltoqmvaiolyqyfykkxxs
# SUPABASE_DB_PASSWORD=<from project creation; used by scripts/supabase-eu-provision.sh>
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# SUPABASE_URL=https://[ref].supabase.co
# SUPABASE_ANON_KEY=<from project settings>
# SUPABASE_SERVICE_ROLE_KEY=<from project settings>
# SUPABASE_DB_URL=<pooler URL, port 6543>
# SUPABASE_DB_DIRECT_URL=<direct URL, port 5432 — use for migrations>

# App identity
RP_ID=localhost
RP_NAME=truffe.ai
ORIGIN=http://localhost:3000
ADMIN_EMAIL=you@example.com

# In PRODUCTION (HTTPS) set these to the __Host- variants:
# SESSION_COOKIE_NAME=__Host-session

# AI advisor
ANTHROPIC_API_KEY=
MODEL_ADVISOR=claude-sonnet-4-6
ADVISOR_DAILY_TOKEN_BUDGET=200000

# Cron (leave unset in local dev to skip the check)
# CRON_SECRET=<min 16 chars>

# Linear (roadmap scripts)
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=

# Phase B-EU — Open banking (TrueLayer primary)
# TRUELAYER_CLIENT_ID=
# TRUELAYER_CLIENT_SECRET=
# TRUELAYER_ENV=sandbox
# AGGREGATOR_OAUTH_STATE_SECRET=<min 16 chars; defaults to CRON_SECRET>
# TINK_CLIENT_ID=
# TINK_CLIENT_SECRET=
# RESEND_API_KEY=
# OBSERVER_INVITE_SECRET=

# Observability (optional — falls back to stdout)
# AXIOM_TOKEN=
# AXIOM_DATASET=
